---
import BaseLayout from '../layouts/BaseLayout.astro';
import { EMAIL } from '../consts';
---
<BaseLayout
  title="Thank You | A2 Commercial Fit Out"
  description="Thanks for your enquiry. A member of the A2 Commercial Fit Out team will be in touch shortly."
  noindex={true}
  canonicalPath="/thank-you/"
>
  <section class="section bg-white">
    <div class="container prose">
      <h1>Thank You, Your Enquiry Has Been Sent</h1>
      <p>We've received your message, and a member of the team will be in touch shortly, usually within one working day.</p>
      <p>If your enquiry is urgent, or you'd like to send drawings or photos, email us at <a href={`mailto:${EMAIL}`}>{EMAIL}</a>.</p>
      <p><a class="btn btn--primary" href="/">Back to the homepage</a></p>
    </div>
  </section>
</BaseLayout>
