---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CaseStudyCard from '../../components/CaseStudyCard.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import { Picture } from 'astro:assets';
import projectsHubImg from '../../assets/images/projects-hub.jpg';
import { getCollection } from 'astro:content';

const caseStudies = (await getCollection('caseStudies')).sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout
  title="Commercial Fit Out Projects | A2 Commercial Fit Out"
  description="Example commercial fit out projects from A2 Commercial Fit Out across office, retail and industrial sectors in London, Kent and Essex."
>
  <div class="container">
    <Breadcrumbs items={[{ label: 'Projects' }]} />
  </div>

  <section class="section--tight bg-white">
    <div class="container">
      <h1>Our Projects</h1>
      <p>Below are example projects illustrating the type of commercial fit out work A2 Commercial Fit Out delivers. These are marked as example projects — full case studies with real client details, photography and verified figures will be published here as they complete.</p>

      <Picture src={projectsHubImg} alt="" width={1200} height={800} widths={[400, 800, 1200]} sizes="(min-width: 48rem) 50vw, 100vw" formats={['avif', 'webp']} fallbackFormat="jpg" loading="lazy" />

      <div class="grid grid--3">
        {caseStudies.map((cs) => (
          <CaseStudyCard
            href={`/projects/${cs.id}/`}
            title={cs.data.title}
            sector={cs.data.sector}
            location={cs.data.location}
            sqFt={cs.data.sqFt}
            durationWeeks={cs.data.durationWeeks}
            placeholder={cs.data.placeholder}
          />
        ))}
      </div>
    </div>
  </section>

  <CtaBanner />
</BaseLayout>
