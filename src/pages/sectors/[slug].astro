---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import ServiceSchema from '../../components/schema/Service.astro';

export async function getStaticPaths() {
  const sectors = await getCollection('sectors');
  return sectors.map((sector) => ({
    params: { slug: sector.id },
    props: { sector },
  }));
}

const { sector } = Astro.props;
const { Content } = await render(sector);
---
<BaseLayout
  title={`${sector.data.title} Contractors | A2 Commercial Fit Out`}
  description={sector.data.metaDescription}
>
  <div class="container">
    <Breadcrumbs items={[{ label: 'Sectors', href: '/sectors' }, { label: sector.data.title }]} />
  </div>

  <section class="section--tight bg-white">
    <div class="container prose">
      <h1>{sector.data.title}</h1>
      <Content />

      <h2>Why Choose A2 Commercial Fit Out</h2>
      <ul>
        <li><strong>Fixed-price quotes</strong> — cost certainty agreed before mobilisation.</li>
        <li><strong>In-house trades</strong> — dry lining, suspended ceilings, tape & jointing and tiling delivered directly, not subcontracted.</li>
        <li><strong>Out-of-hours working</strong> — evening and weekend delivery to protect your operations.</li>
        <li><strong>Speed of delivery</strong> — fast turnaround without compromising on quality or compliance.</li>
      </ul>
    </div>
  </section>

  <CtaBanner />

  <ServiceSchema name={sector.data.title} description={sector.data.metaDescription} url={`/sectors/${sector.id}`} />
</BaseLayout>

<style>
  .prose :global(h2) { margin-top: var(--space-lg); }
</style>
