---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ServiceSchema from '../../components/schema/Service.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import { Picture } from 'astro:assets';
import officeFitOutImg from '../../assets/images/office-fit-out.jpg';

const faqs = [
  {
    question: 'What Is an Office Fit Out?',
    answer: 'An office fit out is the process of designing, building and finishing a commercial office space so it\'s ready for occupation. It typically covers partitioning, ceilings, flooring, M&E works, decoration and furniture coordination, and can apply to Cat A shells or existing offices being fully reconfigured from scratch by our in-house team.',
  },
  {
    question: 'How Much Does an Office Fit Out Cost?',
    answer: 'Costs depend on floor area, specification, and the condition of the existing space. A2 provides a fixed-price quote after reviewing your brief or drawings, so you know the full cost before work starts, with no surprises once the build is underway, whatever the scope of your project.',
  },
  {
    question: 'How Long Does an Office Fit Out Take?',
    answer: 'Timescales vary with scope and floor area, but our in-house trades and out-of-hours working let us compress programmes wherever possible without compromising quality or compliance. Smaller offices can be turned around in a matter of weeks, while larger, multi-floor fit outs typically take several months to complete.',
  },
  {
    question: 'Do You Offer Office Fit Out Design Services?',
    answer: 'A2 is a delivery contractor: we build to a design you already have, whether it\'s your own, your architect\'s, or a designer\'s. We don\'t operate as a design consultancy, but we work closely with your design team throughout the project to make sure what\'s drawn is exactly what gets built on site.',
  },
  {
    question: 'Do You Work Around Occupied Offices?',
    answer: 'Yes. Out-of-hours and phased working are core to how we operate, so occupied buildings and live tenancies can continue running while the fit out takes place. We plan every programme around your operating hours from the outset, so disruption to staff, clients and day-to-day business is kept to an absolute minimum.',
  },
];
---
<BaseLayout
  title="Office Fit Out Company | Fixed-Price Office Fit Outs"
  description="Office fit out contractors delivering Cat A & Cat B fit outs across London & the South East. Fixed-price quotes, in-house trades, fast turnaround."
>
  <div class="container">
    <Breadcrumbs items={[{ label: 'Services', href: '/services' }, { label: 'Office Fit Out' }]} />
  </div>

  <section class="section--tight bg-white">
    <div class="container">
      <h1>Office Fit Out Companies Trust for On-Time, On-Budget Delivery</h1>
      <p>A2 Commercial Fit Out is an <strong>office fit out contractor</strong> delivering Cat A and Cat B office fit outs across London, Kent and Essex. We build to your specification, whether that's come from your own team, an appointed designer, or an architect: our job is to deliver it accurately, on budget, and on time.</p>
      <p>As a delivery contractor rather than a design consultancy, we don't add a design mark-up to every fit out. You get a fixed-price quote for the build, in-house trades on site, and a project manager who keeps the programme on track from strip-out to handover.</p>

      <Picture src={officeFitOutImg} alt="" width={1200} height={800} widths={[400, 800, 1200]} sizes="(min-width: 48rem) 50vw, 100vw" formats={['avif', 'webp']} fallbackFormat="jpg" loading="lazy" />

      <h2>What's Included in an Office Fit Out</h2>
      <p>Office fit out work covers everything needed to turn a shell, Cat A shell, or existing office into a finished, functioning workspace. Typical scope includes:</p>
      <ul>
        <li>Partitioning, ceilings and flooring</li>
        <li>Mechanical and electrical first and second fix</li>
        <li>Decoration and finishes</li>
        <li>Kitchen, breakout and meeting room construction</li>
        <li>Fire safety, compliance and accessibility works</li>
        <li>Coordination with your furniture and IT suppliers for final fit out</li>
      </ul>
      <p>Whether you need a full commercial office fitout across several floors or a smaller office space fit out for a single suite, the process and the fixed-price approach stay the same.</p>

      <h2>Our Office Fit Out Process</h2>
      <ol>
        <li><strong>Brief and specification.</strong> We review your design pack, drawings or brief and confirm the full scope of works.</li>
        <li><strong>Fixed-price quote.</strong> You receive one clear, itemised price before any work begins, not an estimate that grows once we're on site.</li>
        <li><strong>Programme and scheduling.</strong> We agree a delivery programme, including any out-of-hours or phased working needed to keep your business running.</li>
        <li><strong>In-house trades on site.</strong> Our own dry lining, ceilings, tape & jointing and tiling teams deliver the build, backed by our M&E and fit out partners.</li>
        <li><strong>Compliance and sign-off.</strong> All works are delivered in line with Building Regulations, fire safety requirements and CDM 2015.</li>
        <li><strong>Handover.</strong> A completed, snag-free office ready for your team to move into, delivered on the date we quoted.</li>
      </ol>

      <h2>Why Choose A2 As Your Office Fit Out Contractor</h2>
      <ul>
        <li><strong>Fixed-price quotes</strong> remove the risk of costs creeping once the fit out is underway.</li>
        <li><strong>In-house trades</strong> mean one team accountable for quality and programme, not a chain of subcontractors.</li>
        <li><strong>Out-of-hours working</strong> lets fit out work continue around occupied buildings or live tenancies.</li>
        <li><strong>Fast turnaround</strong>, without shortcuts on finish or compliance.</li>
      </ul>
      <p>We work directly with businesses commissioning their own office fitout and design, as well as architects, designers and main contractors who need a reliable delivery partner to build the specification as drawn.</p>

      <h2>Office Fit Out Specialists for Every Project Size</h2>
      <p>From a single-floor commercial office fit out to a multi-site turnkey office fit out, our in-house model scales to the size of the project without changing the fundamentals: one fixed price, one accountable team, one programme.</p>

      <FaqAccordion items={faqs} />

      <p class="related-links">Related: <a href="/services/office-refurbishment">Office Refurbishment</a> · <a href="/services/landlord-refurbishment">Landlord Refurbishment</a></p>
    </div>
  </section>

  <CtaBanner heading="Ready To Quote Your Office Fit Out?" body="Send us your design pack or brief and we'll come back with a fixed-price quote and realistic programme." />

  <ServiceSchema name="Office Fit Out" description="Cat A and Cat B office fit out delivered to a fixed price by in-house trades across London, Kent, Essex and the South East." url="/services/office-fit-out" />
</BaseLayout>

<style>
  .related-links { font-size: var(--step--1); color: var(--text-on-light-muted); margin-top: var(--space-md); }
</style>

