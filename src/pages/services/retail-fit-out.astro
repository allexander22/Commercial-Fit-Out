---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ServiceSchema from '../../components/schema/Service.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import { Picture } from 'astro:assets';
import retailFitOutImg from '../../assets/images/retail-fit-out.jpg';

const faqs = [
  {
    question: 'Can You Deliver a Shop Fit Out Around a Fixed Opening Date?',
    answer: 'Yes — protecting the opening date is usually the top priority on a retail programme, and we plan the build sequence and out-of-hours working specifically around it.',
  },
  {
    question: 'Do You Work Inside Occupied Shopping Centres?',
    answer: 'Yes. We regularly work inside trading shopping centres, planning disruptive trades around centre-management booking systems and trading hours so neighbouring tenants aren\'t affected.',
  },
  {
    question: 'Do You Fit Out Multiple Retail Units As Part of a Rollout?',
    answer: 'Yes, we work with retailers and operators on both single-unit fit outs and multi-site rollout programmes, applying the same fixed-price approach across every unit.',
  },
  {
    question: 'Is the Quote Fixed Even If the Opening Date Is Tight?',
    answer: 'Yes — the price is agreed before mobilisation regardless of programme length, so a compressed timeline doesn\'t change your budget certainty.',
  },
];
---
<BaseLayout
  title="Retail Fit Out Contractors | A2 Commercial Fit Out"
  description="Retail and shop fit out contractors delivering fast, fixed-price fit outs across London, Kent and Essex, protecting opening dates and trading hours."
>
  <div class="container">
    <Breadcrumbs items={[{ label: 'Services', href: '/services' }, { label: 'Retail Fit Out' }]} />
  </div>

  <section class="section--tight bg-white">
    <div class="container">
      <h1>Retail Fit Out</h1>
      <p>A2 Commercial Fit Out is a <strong>retail fit out company</strong> delivering shop and unit fit outs across London, Kent, Essex and the South East. As experienced <strong>retail fit out contractors</strong>, we understand that a fixed opening date is usually non-negotiable, and we build every programme to protect it.</p>

      <Picture src={retailFitOutImg} alt="" width={1200} height={800} widths={[400, 800, 1200]} sizes="(min-width: 48rem) 50vw, 100vw" formats={['avif', 'webp']} fallbackFormat="jpg" loading="lazy" />

      <h2>Shop Fitout That Protects Your Opening Date</h2>
      <p>Retail launches are planned around a fixed date — stock deliveries, staff recruitment and marketing are all scheduled against it, which means a slipped fit out programme has consequences well beyond the building itself. We plan every retail programme backwards from your opening date, building in contingency and sequencing trades so the critical path is protected even if site conditions shift once work starts.</p>

      <h2>What Our Retail Fit Out Service Includes</h2>
      <ul>
        <li>Shell-and-core to trading-ready unit fit out</li>
        <li>Partitioning for back-of-house, stockroom and staff welfare areas</li>
        <li>Washroom and staff facility fit out, including tiling</li>
        <li>Ceiling, lighting grid and shopfront-adjacent internal works</li>
        <li>Floor finishes to retailer specification</li>
        <li>Coordination with shopfitters, signage contractors and M&E specialists</li>
      </ul>

      <h2>Working Inside Occupied Centres</h2>
      <p>Many of our retail projects sit inside trading shopping centres or busy high streets, where neighbouring units continue trading throughout our works. We plan disruptive trades — demolition, floor preparation, ceiling replacement — around centre-management booking systems, service-corridor access windows and trading hours, using out-of-hours and overnight working to keep noise and disruption away from your neighbours.</p>

      <h2>In-House Trades for Faster Turnaround</h2>
      <p>Dry lining, suspended ceilings, tape & jointing and tiling are delivered by our own trades teams rather than subcontractors, which is one of the main reasons we can compress retail programmes without cutting corners on finish quality. Direct control over these packages means less time lost to subcontractor scheduling, and more capacity to run trades in parallel when a tight opening date demands it.</p>

      <h2>Fixed Price, Every Time</h2>
      <p>Every retail fit out is quoted at a fixed price agreed before mobilisation — whatever the programme length, size of unit, or number of locations involved. There's no minimum project value, so single independent units and multi-site rollout programmes both get the same fixed-price, in-house-trade delivery model, backed by our CHAS and SafeContractor accreditation and full Building Regulations and fire safety compliance.</p>

      <FaqAccordion items={faqs} />
    </div>
  </section>

  <CtaBanner heading="Working to a Fixed Opening Date?" body="Send us your unit details and target date and we'll come back with a fixed-price programme to hit it." />

  <ServiceSchema name="Retail Fit Out" description="Shop and retail unit fit out delivered to a fixed price by in-house trades across London, Kent, Essex and the South East." url="/services/retail-fit-out" />
</BaseLayout>
