---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ServiceSchema from '../../components/schema/Service.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import { Picture } from 'astro:assets';
import landlordRefurbImg from '../../assets/images/landlord-refurbishment.jpg';

const faqs = [
  {
    question: 'What\'s the difference between Cat A and Cat B refurbishment?',
    answer: 'Cat A refurbishment brings a space to a clean, functional shell standard, ready for a tenant to fit out. Cat B refers to the tenant\'s own fit out on top of that shell. A2 delivers Cat A refurbishment directly and can coordinate Cat B works where a landlord is supporting a tenant\'s fit out costs.',
  },
  {
    question: 'Can refurbishment work take place while other parts of the building are occupied?',
    answer: 'Yes. Out-of-hours and phased working are standard on multi-let refurbishment projects, so other tenants aren\'t disrupted while work takes place. We coordinate access, noise and timing carefully with building management, so the rest of the property continues operating normally throughout the entire refurbishment programme, from initial scoping through to final handover and sign-off.',
  },
  {
    question: 'How much does a landlord refurbishment cost?',
    answer: 'Cost depends on the scope, the building\'s condition, and whether works cover common parts, Cat A space, or a full building. We provide a fixed-price quote once we understand the target standard and timeline, so the refurbishment budget can be built into your investment case with confidence from day one.',
  },
  {
    question: 'How long does landlord refurbishment typically take?',
    answer: 'Timescales depend on scope and building size, but minimising void periods is central to how we plan every landlord project. We agree a fixed programme upfront and use phased or out-of-hours working wherever needed to get your space back on the market and earning rent as quickly as possible.',
  },
  {
    question: 'Can refurbishment improve a building\'s EPC rating?',
    answer: 'Yes, refurbishment is often the most practical point to upgrade lighting, controls and building fabric to meet current and upcoming EPC requirements. Improving a building\'s rating during refurbishment avoids a separate, disruptive project later and can materially strengthen its position with prospective tenants and investors.',
  },
];
---
<BaseLayout
  title="Landlord Refurbishment Contractor | Fixed-Price Cat A & Cat B"
  description="Landlord refurbishment specialists delivering Cat A, Cat B and common-area refurbishment across London & the South East. Fixed price, in-house trades."
>
  <div class="container">
    <Breadcrumbs items={[{ label: 'Services', href: '/services/' }, { label: 'Landlord Refurbishment' }]} />
  </div>

  <section class="section--tight bg-white">
    <div class="container">
      <h1>Landlord Refurbishment, Delivered to a Fixed Price and a Fixed Deadline</h1>
      <p>A2 Commercial Fit Out delivers <strong>landlord refurbishment</strong> across London, Kent and Essex: repositioning vacant or ageing commercial space so it's ready to let, at a fixed price agreed up front. Every void period costs a landlord money, and every refurbishment that overruns costs more. Our fixed-price model and in-house trades exist to remove both risks.</p>
      <p>We work on behalf of landlords, asset managers, managing agents and property investors, refurbishing common parts, reception areas, Cat A and Cat B space, and full buildings ahead of re-letting.</p>

      <Picture src={landlordRefurbImg} alt="" width={1200} height={800} widths={[400, 800, 1200]} sizes="(min-width: 48rem) 50vw, 100vw" formats={['avif', 'webp']} fallbackFormat="jpg" loading="lazy" />

      <h2>What's included in landlord refurbishment</h2>
      <ul>
        <li><strong>Cat A refurbishment</strong> — bringing space back to a clean, lettable shell standard for incoming tenants.</li>
        <li><strong>Cat B fit out coordination</strong> — supporting tenant fit out work where required as part of a lease agreement.</li>
        <li><strong>Common parts and reception refurbishment</strong> — entrance areas, lifts, corridors and WCs.</li>
        <li><strong>End-of-trip and amenity space</strong> — cycle storage, showers and changing facilities to meet modern tenant expectations.</li>
        <li><strong>Dilapidations works</strong> — restoring space to the condition required at lease end.</li>
        <li><strong>EPC and compliance improvements</strong> — upgrading lighting, controls and building fabric to meet current energy efficiency requirements.</li>
      </ul>

      <h2>Our landlord refurbishment process</h2>
      <ol>
        <li><strong>Asset review.</strong> We assess the space, the lease position, and the target standard for re-letting.</li>
        <li><strong>Fixed-price quote.</strong> A single agreed price for the refurbishment scope, so it can be planned into your investment case with certainty.</li>
        <li><strong>Phased or out-of-hours delivery.</strong> Where parts of the building remain occupied by other tenants, work is scheduled to avoid disruption.</li>
        <li><strong>In-house trades.</strong> Our own dry lining, ceilings, tiling and finishing teams deliver the work directly, keeping quality and programme under our control.</li>
        <li><strong>Compliance and handover.</strong> Works are completed to Building Regulations, fire safety and CDM 2015 requirements, with the space ready for marketing or occupation on the agreed date.</li>
      </ol>

      <h2>Why landlords choose A2 for refurbishment</h2>
      <ul>
        <li><strong>Fixed-price quotes</strong> protect the return on a refurbishment before it starts, with no cost creep to erode the numbers.</li>
        <li><strong>In-house trades</strong> mean one accountable team delivering the work, not a subcontractor chain that's hard to manage remotely.</li>
        <li><strong>Out-of-hours working</strong> keeps refurbishment moving around occupied tenants in multi-let buildings.</li>
        <li><strong>Speed of delivery</strong> shortens void periods and gets space back on the market faster.</li>
      </ul>

      <FaqAccordion items={faqs} />

      <p class="related-links">Related: <a href="/services/office-refurbishment/">Office Refurbishment</a> · <a href="/services/office-fit-out/">Office Fit Out</a></p>
    </div>
  </section>

  <CtaBanner heading="Planning a landlord refurbishment?" body="Tell us about the asset and the target re-letting standard and we'll come back with a fixed-price quote." />

  <ServiceSchema name="Landlord Refurbishment" description="Cat A, Cat B and common-area landlord refurbishment delivered to a fixed price by in-house trades across London, Kent, Essex and the South East." url="/services/landlord-refurbishment/" />
</BaseLayout>

<style>
  .related-links { font-size: var(--step--1); color: var(--text-on-light-muted); margin-top: var(--space-md); }
</style>
