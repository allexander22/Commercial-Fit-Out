---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ServiceSchema from '../../components/schema/Service.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import { Picture } from 'astro:assets';
import healthcareFitOutImg from '../../assets/images/healthcare-fit-out.jpg';

const faqs = [
  {
    question: 'What\'s the difference between a hospital fit out and a hospital refurbishment?',
    answer: 'A hospital fit out typically fits out a new or empty clinical space for the first time, while a hospital refurbishment updates or reconfigures existing clinical or non-clinical areas. A2 delivers both under the same fixed-price, in-house model, so infection control and compliance standards stay consistent throughout.',
  },
  {
    question: 'What\'s different about a hospital or healthcare fit out compared to a standard commercial fit out?',
    answer: 'Healthcare fit out requires additional attention to infection control, containment during works, and specification of finishes suited to clinical environments, on top of standard Building Regulations and fire safety compliance. Our in-house trades are experienced in maintaining strict hygiene and containment standards throughout every phase of the project.',
  },
  {
    question: 'Can you carry out fit out or refurbishment work in a hospital or clinic that\'s still operating?',
    answer: 'Yes. Phased and out-of-hours working are standard practice for healthcare projects, allowing clinical services to continue running around the works. We agree containment measures, access routes and working hours with your estates team in advance, so patient care is never compromised while the fit out or refurbishment is underway.',
  },
  {
    question: 'How much does a hospital or healthcare fit out cost?',
    answer: 'Cost depends on whether the space is clinical or non-clinical, the level of infection control required, and the existing condition of the space. We provide a fixed-price quote once the scope and compliance requirements are confirmed, so your budget is set before any containment or clinical works begin on site.',
  },
  {
    question: 'Do you fit out and refurbish both clinical and non-clinical space?',
    answer: 'Yes, from consulting and treatment rooms through to reception, administrative and staff areas. Whatever the mix of clinical and non-clinical space in your project, our in-house trades deliver every part of it to the same fixed price, compliance standard and infection control specification, without switching contractors between areas.',
  },
];
---
<BaseLayout
  title="Healthcare Fit Out Contractor | A2 Commercial Fit Out"
  description="Healthcare fit out contractor delivering compliant clinical and healthcare environments across London, Kent and Essex. Fixed-price, in-house trades."
>
  <div class="container">
    <Breadcrumbs items={[{ label: 'Services', href: '/services/' }, { label: 'Healthcare Fit Out' }]} />
  </div>

  <section class="section--tight bg-white">
    <div class="container">
      <h1>Healthcare Fit Out, Delivered to Clinical Standards and a Fixed Price</h1>
      <p>A2 Commercial Fit Out delivers <strong>hospital fit out</strong> and <strong>hospital refurbishment</strong> for healthcare providers across London, Kent and Essex. Healthcare fit out comes with tighter compliance requirements and less tolerance for disruption than a standard commercial project, which is exactly why our fixed-price, in-house delivery model matters here.</p>
      <p>We work with healthcare providers, estates teams and main contractors to deliver clinical and non-clinical space, from consulting rooms and wards to reception and administrative areas, without compromising infection control or patient safety during works.</p>

      <Picture src={healthcareFitOutImg} alt="" width={1200} height={800} widths={[400, 800, 1200]} sizes="(min-width: 48rem) 50vw, 100vw" formats={['avif', 'webp']} fallbackFormat="jpg" loading="lazy" />

      <h2>What's included in hospital and healthcare fit out</h2>
      <ul>
        <li><strong>Clinical space fit out</strong> — consulting rooms, treatment rooms and ward areas built to the required finishes and infection control standards.</li>
        <li><strong>Hospital and healthcare refurbishment</strong> — updating existing clinical and non-clinical space, from redecoration and flooring through to full reconfiguration.</li>
        <li><strong>Non-clinical space</strong> — reception, administration, staff and waiting areas.</li>
        <li><strong>Infection control compliance</strong> — specification of finishes, sealants and containment measures appropriate to healthcare environments.</li>
        <li><strong>Phased and out-of-hours delivery</strong> — works scheduled to keep clinical areas operational throughout.</li>
        <li><strong>Compliance</strong> — delivered in line with Building Regulations, fire safety requirements and CDM 2015, alongside the infection control and estates standards specific to healthcare settings.</li>
      </ul>

      <h2>Our approach to hospital and healthcare fit out</h2>
      <ol>
        <li><strong>Scope and compliance review.</strong> We confirm the clinical and infection control requirements for the space before pricing the works.</li>
        <li><strong>Fixed-price quote.</strong> A clear, agreed price covering the full compliant scope.</li>
        <li><strong>Phased or out-of-hours programme.</strong> Works are scheduled to avoid disruption to live clinical services wherever possible.</li>
        <li><strong>In-house trades.</strong> Our own delivery team carries out the work under direct supervision, rather than through a subcontractor chain, keeping quality and containment consistent throughout.</li>
        <li><strong>Sign-off and handover.</strong> Completed space is signed off against Building Regulations, fire safety and infection control requirements before handover.</li>
      </ol>

      <h2>Why healthcare providers choose A2</h2>
      <ul>
        <li><strong>Fixed-price quotes</strong> bring cost certainty to projects that often carry additional compliance overhead.</li>
        <li><strong>In-house trades</strong> mean tighter control over containment, cleanliness and quality on sensitive sites.</li>
        <li><strong>Out-of-hours working</strong> keeps clinical services running while work takes place.</li>
        <li><strong>Speed of delivery</strong> reduces the time clinical or patient-facing space is out of action.</li>
      </ul>

      <h2>Compliance and accreditation</h2>
      <p>Every hospital and healthcare fit out is delivered in line with current Building Regulations and fire safety requirements, with CDM 2015 duties managed appropriately for the project. We hold CHAS and SafeContractor accreditation, giving healthcare clients and their compliance teams confidence in our health and safety management systems before work begins.</p>

      <FaqAccordion items={faqs} />

      <p class="related-links">Related: <a href="/services/office-fit-out/">Office Fit Out</a> · <a href="/services/office-refurbishment/">Office Refurbishment</a></p>
    </div>
  </section>

  <CtaBanner heading="Planning a hospital or healthcare fit out?" body="Share your specification and we'll come back with a fixed-price quote built around your clinical operation." />

  <ServiceSchema name="Healthcare Fit Out" description="Compliant hospital and healthcare fit out delivered to a fixed price by in-house trades across London, Kent, Essex and the South East." url="/services/healthcare-fit-out/" />
</BaseLayout>

<style>
  .related-links { font-size: var(--step--1); color: var(--text-on-light-muted); margin-top: var(--space-md); }
</style>
