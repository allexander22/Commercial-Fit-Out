---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import UspGrid from '../../components/UspGrid.astro';
import officeFitOutImg from '../../assets/images/office-fit-out.jpg';
import officeRefurbImg from '../../assets/images/office-refurbishment.jpg';
import retailFitOutImg from '../../assets/images/retail-fit-out.jpg';
import healthcareFitOutImg from '../../assets/images/healthcare-fit-out.jpg';
import landlordRefurbImg from '../../assets/images/landlord-refurbishment.jpg';
import higherEducationImg from '../../assets/images/higher-education-fit-out.jpg';
---
<BaseLayout
  title="Fit Out Company & Contractor | A2 Commercial Fit Out"
  description="Commercial fit out services from A2 Commercial Fit Out: office, refurbishment, retail, healthcare, landlord and education fit out. Fixed-price, in-house trades, South East coverage."
>
  <div class="container">
    <Breadcrumbs items={[{ label: 'Services' }]} />
  </div>

  <section class="section--tight bg-white">
    <div class="container">
      <h1>Commercial fit out services</h1>
      <p>A2 Commercial Fit Out is a <strong>fit out company</strong> and <strong>fit out contractor</strong> delivering complete commercial interiors across London, Kent, Essex and the South East. Every service below is delivered by our own in-house trades to a fixed price, whatever the scale of the project.</p>

      <div class="grid grid--4 services-grid">
        <ServiceCard href="/services/office-fit-out/" title="Office Fit Out" description="Cat A, Cat B and turnkey office fit out delivered to a fixed price." image={officeFitOutImg} imageAlt="" />
        <ServiceCard href="/services/office-refurbishment/" title="Office Refurbishment" description="Refurbishment of existing office space with minimal disruption to your team." image={officeRefurbImg} imageAlt="" />
        <ServiceCard href="/services/retail-fit-out/" title="Retail Fit Out" description="Shop and retail unit fit out delivered fast, to protect your opening date." image={retailFitOutImg} imageAlt="" />
        <ServiceCard href="/services/healthcare-fit-out/" title="Healthcare Fit Out" description="Compliant healthcare and clinical fit out delivered by trusted trades." image={healthcareFitOutImg} imageAlt="" />
        <ServiceCard href="/services/landlord-refurbishment/" title="Landlord Refurbishment" description="Cat A, Cat B and common-area refurbishment ahead of re-letting." image={landlordRefurbImg} imageAlt="" />
        <ServiceCard href="/services/higher-education-fit-out/" title="Higher Education Fit Out" description="Education fit out and refurbishment delivered around term dates." image={higherEducationImg} imageAlt="" />
      </div>

      <h2>Delivered by our own in-house trades</h2>
      <p>Dry lining, suspended ceilings, tape & jointing and tiling all sit in-house at A2 Commercial Fit Out, which means the packages most likely to cause delay on a typical commercial fit out programme stay under our direct control rather than a subcontractor's. Combined with a fixed-price quote agreed before mobilisation, that gives clients genuine cost and programme certainty across every service we offer.</p>

      <UspGrid />

      <h2>Sectors and specialisms</h2>
      <p>Beyond our core services, we also deliver fit outs for specific sectors including industrial units, pubs and bars, turnkey projects, bespoke joinery and retail shops. Visit our <a href="/sectors/">sectors page</a> for detail on each.</p>
    </div>
  </section>

  <CtaBanner />
</BaseLayout>
