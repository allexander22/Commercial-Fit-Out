---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import UspGrid from '../components/UspGrid.astro';
import ServiceCard from '../components/ServiceCard.astro';
import CaseStudyCard from '../components/CaseStudyCard.astro';
import InsightCard from '../components/InsightCard.astro';
import ContactForm from '../components/ContactForm.astro';
import CtaBanner from '../components/CtaBanner.astro';
import AccreditationBadges from '../components/AccreditationBadges.astro';
import { Picture } from 'astro:assets';
import heroImage from '../assets/images/hero.jpg';
import officeFitOutImg from '../assets/images/office-fit-out.jpg';
import officeRefurbImg from '../assets/images/office-refurbishment.jpg';
import retailFitOutImg from '../assets/images/retail-fit-out.jpg';
import healthcareFitOutImg from '../assets/images/healthcare-fit-out.jpg';
import servingAreaImg from '../assets/images/A2 Commercial Fit Out Serving Area.png';
import outOfHoursImg from '../assets/images/out-of-hours-refurbishment.jpg';
import budgetImg from '../assets/images/managing-fit-out-costs.jpg';
import { getCollection } from 'astro:content';
import type { ImageMetadata } from 'astro';

const caseStudies = (await getCollection('caseStudies')).sort((a, b) => a.data.order - b.data.order);

const insightImages: Record<string, ImageMetadata> = {
  'healthcare-fit-out-compliance-requirements': healthcareFitOutImg,
  'benefits-of-out-of-hours-office-refurbishment': outOfHoursImg,
  'managing-commercial-fit-out-projects-fixed-budget': budgetImg,
};
const latestInsights = (await getCollection('insights'))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 3);
---
<BaseLayout
  title="Commercial Fit Out Company | Fixed-Price Fit Out & Refurbishment"
  description="A2 Commercial Fit Out delivers commercial fit out and refurbishment across London & the South East. Fixed-price quotes, in-house trades, out-of-hours working."
>
  <Hero image={heroImage} imageAlt="" eyebrow="Commercial Fit Out Contractor" video="/A2%20Commercial%20Fit%20Out%20Intro.mp4">
    <Fragment slot="heading">Commercial Fit Out, Delivered on a Fixed Price</Fragment>
    <p>A2 Commercial Fit Out is a UK commercial fit out company delivering office fit outs, refurbishments, retail spaces and healthcare environments across London, Kent and Essex. We're a fit out contractor, not a design house: give us the brief and the drawings, and we build to spec, on budget, and on time.</p>
    <Fragment slot="actions">
      <a class="btn btn--primary" href="/contact">Get a fixed-price quote</a>
      <a class="btn btn--outline-dark" href="/services">Explore our services</a>
    </Fragment>
  </Hero>

  <section class="section bg-white">
    <div class="container">
      <h2>Why Clients Choose A2 Commercial Fit Out</h2>
      <p>Every quote is fixed before work starts. Every trade on site is our own, not a subcontractor chain we're hoping holds together. And if your business can't stop for scaffolding, we'll work around you: evenings, weekends, whatever it takes to keep you trading.</p>
      <UspGrid />
    </div>
  </section>

  <section class="section bg-steel">
    <div class="container">
      <h2>What We Do</h2>
      <p>A2 covers the full spectrum of commercial fit out and refurbishment, from a single-room refresh to a complete turnkey fit out. We work directly with businesses, landlords, developers and main contractors, and we're a dependable delivery partner for architects and designers who need their specification built exactly as drawn.</p>
      <div class="grid grid--4 services-grid">
        <ServiceCard href="/services/office-fit-out" title="Office Fit Out" description="Cat A, Cat B and turnkey office fit out delivered to a fixed price." image={officeFitOutImg} imageAlt="" />
        <ServiceCard href="/services/office-refurbishment" title="Office Refurbishment" description="Refurbishment of existing office space with minimal disruption to your team." image={officeRefurbImg} imageAlt="" />
        <ServiceCard href="/services/retail-fit-out" title="Retail Fit Out" description="Shop and retail unit fit out delivered fast, to protect your opening date." image={retailFitOutImg} imageAlt="" />
        <ServiceCard href="/services/healthcare-fit-out" title="Healthcare Fit Out" description="Compliant healthcare and clinical fit out, including hospital settings, delivered by trusted trades." image={healthcareFitOutImg} imageAlt="" />
      </div>
      <p>We also deliver <a href="/services/landlord-refurbishment">landlord refurbishment</a>, repositioning commercial assets ahead of re-letting, and <a href="/services/higher-education-fit-out">higher education fit out and refurbishment</a>, built around university and college term dates.</p>
      <p><a class="btn btn--outline-light" href="/services">View all services</a></p>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container serving-area-section">
      <h2>Serving London, Kent and Essex</h2>
      <p>A2 Commercial Fit Out is based in Maidstone, Kent, and delivers commercial fit out and refurbishment projects across London and the South East. We cover Kent, Essex and Greater London as standard, with further UK regions available on request.</p>
      <Picture src={servingAreaImg} alt="Map of London, Kent, Essex and the wider South East covered by A2 Commercial Fit Out" width={1600} height={900} widths={[600, 900, 1200]} sizes="(min-width: 48rem) 44rem, 90vw" formats={['avif', 'webp']} fallbackFormat="jpg" loading="lazy" class="serving-area-img" />
    </div>
  </section>

  <section class="section bg-steel">
    <div class="container">
      <h2>Recent Project Examples</h2>
      <p>A selection of example projects illustrating the type of work we deliver. Full case studies with real client details and photography are coming soon.</p>
      <div class="grid grid--3">
        {caseStudies.map((cs) => (
          <CaseStudyCard
            href={`/projects/${cs.id}`}
            title={cs.data.title}
            sector={cs.data.sector}
            location={cs.data.location}
            sqFt={cs.data.sqFt}
            durationWeeks={cs.data.durationWeeks}
            placeholder={cs.data.placeholder}
          />
        ))}
      </div>
      <p><a class="btn btn--outline-light" href="/projects">View all projects</a></p>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container accreditation-section">
      <h2>Accredited and Compliant</h2>
      <p>Every fit out project comes down to the people on site. Our team brings over 15 years' experience delivering commercial projects across London and the South East, with a background in dry lining, suspended ceilings, tape & jointing and tiling — that's why we run our own trades rather than subcontracting the work out. We hold CHAS and SafeContractor accreditation, and every project is delivered in line with current Building Regulations, fire safety requirements and CDM 2015.</p>
      <AccreditationBadges />
    </div>
  </section>

  <section class="section bg-ink">
    <div class="container">
      <div class="insights-head">
        <div>
          <h2>Latest Insights</h2>
          <p>Practical guides on commercial fit out costs, compliance and project delivery, written to help you plan before you request a quote.</p>
        </div>
        <a class="btn btn--outline-dark insights-head-link" href="/insights">View all insights</a>
      </div>
      <div class="grid grid--3">
        {latestInsights.map((article) => (
          <InsightCard
            href={`/insights/${article.id}`}
            title={article.data.title}
            summary={article.data.summary}
            image={insightImages[article.id]}
            readTime={article.data.readTime}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-steel">
    <div class="container contact-form-section">
      <h2>Get a Fixed-Price Quote</h2>
      <p>Tell us about your project and we'll come back with a fixed-price quote and a realistic programme.</p>
      <ContactForm compact />
    </div>
  </section>

  <CtaBanner />
</BaseLayout>

<style>
  .insights-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: var(--space-md);
    margin-bottom: var(--space-lg);
  }
  .insights-head p {
    color: var(--text-on-dark-muted);
    max-width: 34rem;
    margin-bottom: 0;
  }
  .insights-head-link { flex-shrink: 0; }
  .contact-form-section {
    max-width: 40rem;
  }
  .accreditation-section h2, .accreditation-section p { text-align: left; }
  .serving-area-section {
    text-align: center;
  }
  .serving-area-section p {
    max-width: 44rem;
    margin-inline: auto;
  }
  .serving-area-img {
    display: block;
    width: 100%;
    max-width: 44rem;
    height: auto;
    margin-top: var(--space-md);
    margin-inline: auto;
    border-radius: var(--radius-md);
  }
</style>
