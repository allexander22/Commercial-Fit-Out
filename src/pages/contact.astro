---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import AccreditationBadges from '../components/AccreditationBadges.astro';
import ContactForm from '../components/ContactForm.astro';
import { EMAIL, PHONE, ADDRESS_LOCALITY, ADDRESS_REGION } from '../consts';
---
<BaseLayout
  title="Contact Us | A2 Commercial Fit Out"
  description="Contact A2 Commercial Fit Out for a fixed-price commercial fit out quote across London, Kent, Essex and the South East. Email or use our enquiry form."
>
  <div class="container">
    <Breadcrumbs items={[{ label: 'Contact' }]} />
  </div>

  <section class="section--tight bg-white">
    <div class="container contact-grid">
      <div class="contact-intro prose">
        <h1>Contact Us</h1>
        <p>Tell us about your project and we'll come back with a fixed-price quote and a realistic programme. There's no minimum project size, and every enquiry is answered by our team directly — not a call centre.</p>

        <h2>Email Us</h2>
        <p>The fastest way to reach us right now is by email:</p>
        <p><a class="btn btn--primary" href={`mailto:${EMAIL}`}>{EMAIL}</a></p>

        {PHONE && (
          <>
            <h2>Call Us</h2>
            <p><a href={`tel:${PHONE}`}>{PHONE}</a></p>
          </>
        )}

        <h2>Where We Work</h2>
        <p>Based in {ADDRESS_LOCALITY}, {ADDRESS_REGION}, we deliver commercial fit out projects across London, Kent, Essex and the wider South East.</p>

        <h2>Accreditation</h2>
        <AccreditationBadges />
      </div>

      <ContactForm />
    </div>
  </section>
</BaseLayout>

<style>
  .contact-grid {
    display: grid;
    gap: var(--space-lg);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    align-items: start;
  }
</style>
