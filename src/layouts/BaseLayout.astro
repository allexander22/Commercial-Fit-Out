---
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieConsent from '../components/CookieConsent.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  canonicalPath?: string;
}
const { title, description, image, type, noindex, canonicalPath } = Astro.props;

// Astro/Vite's dev server injects CSS and dev-toolbar bootstrapping as
// inline/dynamically-created <style>/<script> tags for HMR, which a strict
// CSP blocks outright (the production build in dist/ only ever emits
// external <link>/<script src> files, so the strict policy applies there
// unchanged). Loosen script-src/style-src only for `astro dev`.
// Google reCAPTCHA (contact form spam protection) is this site's one
// deliberate third-party dependency — it cannot be self-hosted (Google
// requires the widget script to load live), so script-src/frame-src/
// connect-src carry explicit google.com/gstatic.com exceptions rather
// than the site's usual self-only policy.
const csp = [
  "default-src 'self'",
  import.meta.env.DEV
    ? "script-src 'self' 'unsafe-inline' https://www.google.com https://www.gstatic.com"
    : "script-src 'self' https://www.google.com https://www.gstatic.com",
  import.meta.env.DEV ? "style-src 'self' 'unsafe-inline'" : "style-src 'self'",
  "img-src 'self' data: https://www.gstatic.com",
  "font-src 'self'",
  "frame-src https://www.google.com",
  "connect-src 'self' https://www.google.com",
  "object-src 'none'",
  "base-uri 'self'",
  "form-action 'self' https://api.web3forms.com",
  'upgrade-insecure-requests',
].join('; ');
---
<!doctype html>
<html lang="en-GB" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="Content-Security-Policy" content={csp} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="generator" content={Astro.generator} />
    <Seo title={title} description={description} image={image} type={type} noindex={noindex} canonicalPath={canonicalPath} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <CookieConsent />
    <script src="../scripts/nav.js"></script>
  </body>
</html>
