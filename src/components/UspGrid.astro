---
const usps = [
  {
    title: 'Fixed-price quotes',
    body: 'Cost certainty from day one — the price you agree is the price you pay, with no hidden variations.',
    icon: '<path d="M12.59 2.59A2 2 0 0 0 11.17 2H4a2 2 0 0 0-2 2v7.17a2 2 0 0 0 .59 1.41l9 9a2 2 0 0 0 2.82 0l7.17-7.17a2 2 0 0 0 0-2.82zM7 7h.01"/>',
  },
  {
    title: 'In-house trades',
    body: 'Dry lining, suspended ceilings, tape & jointing and tiling delivered by our own tradespeople, not subcontractors — direct control of quality and programme.',
    icon: '<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94z"/>',
  },
  {
    title: 'Out-of-hours working',
    body: 'Evening and weekend delivery so your operations, staff or tenants keep running throughout the works.',
    icon: '<path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z"/>',
  },
  {
    title: 'Speed of delivery',
    body: 'Fast turnaround from survey to handover, without compromising on quality or Building Regulations compliance.',
    icon: '<path d="M13 2 4 14h6l-1 8 9-12h-6l1-8z"/>',
  },
];
---
<div class="usp-grid grid grid--4">
  {usps.map((usp) => (
    <div class="usp-card card">
      <span class="usp-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={usp.icon} />
      </span>
      <h3>{usp.title}</h3>
      <p>{usp.body}</p>
    </div>
  ))}
</div>

<style>
  .usp-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background: rgba(47, 125, 209, 0.1);
    color: var(--colour-blue-500);
    margin-bottom: var(--space-sm);
  }
  .usp-icon svg {
    width: 1.5rem;
    height: 1.5rem;
  }
  .usp-card h3 {
    font-size: var(--step-1);
    color: var(--link-on-light);
  }
  .usp-card p {
    margin-bottom: 0;
    color: var(--text-on-light-muted);
  }
</style>
