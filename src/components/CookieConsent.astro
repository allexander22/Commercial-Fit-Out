---
// Cookie preferences banner. Consent is persisted via localStorage and
// gates Google Analytics 4 (src/scripts/analytics.js), which loads only
// when `window.a2CookieConsent.hasAnalyticsConsent()` is true or an
// `a2:consent-change` event grants analytics consent mid-visit.
---
<div class="cookie-consent" role="dialog" aria-modal="false" aria-labelledby="cookie-consent-heading" hidden>
  <h2 id="cookie-consent-heading">Cookies Preferences</h2>
  <p>This website uses cookies that help the site function and help us understand how visitors interact with it. We use these to provide you with an improved, more relevant experience. Please let us know if you're happy for us to use non-essential cookies.</p>
  <p class="cookie-consent-note">Analytics cookies are only set if you accept all cookies. You can change your preference at any time — see our <a href="/privacy-policy/">privacy policy</a> for details.</p>

  <div class="cookie-consent-actions">
    <button type="button" class="btn btn--primary" data-cookie-accept-all>
      Accept all cookies
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
    </button>
    <button type="button" class="btn btn--outline-dark" data-cookie-manage aria-expanded="false" aria-controls="cookie-consent-manage">
      Manage cookies
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
    </button>
  </div>

  <div class="cookie-consent-manage" id="cookie-consent-manage" hidden>
    <div class="cookie-consent-option">
      <div>
        <p class="cookie-consent-option-title">Necessary cookies</p>
        <p class="cookie-consent-option-body">Required for the site to work correctly. Always active.</p>
      </div>
    </div>
    <div class="cookie-consent-option">
      <label class="cookie-consent-option-title" for="cookie-analytics-toggle">
        <input type="checkbox" id="cookie-analytics-toggle" />
        Analytics cookies
      </label>
      <p class="cookie-consent-option-body">Help us understand how visitors use the site, so we can improve it.</p>
    </div>
    <div class="cookie-consent-actions">
      <button type="button" class="btn btn--primary" data-cookie-accept-all>
        Accept all cookies
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </button>
      <button type="button" class="btn btn--outline-dark" data-cookie-save>
        Save preferences
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </button>
    </div>
  </div>
</div>

<script src="../scripts/cookie-consent.js"></script>

<style>
  .cookie-consent {
    position: fixed;
    left: var(--space-sm);
    right: var(--space-sm);
    bottom: var(--space-sm);
    z-index: 100;
    max-width: 26rem;
    background: var(--colour-ink);
    color: var(--text-on-dark);
    border: 1px solid var(--colour-ink-border);
    border-radius: var(--radius-md);
    padding: var(--space-md);
    box-shadow: 0 1rem 3rem rgba(0, 0, 0, 0.35);
  }
  .cookie-consent[hidden] { display: none; }
  .cookie-consent h2 {
    font-size: var(--step-1);
    margin-bottom: var(--space-sm);
  }
  .cookie-consent p {
    color: var(--text-on-dark-muted);
    font-size: var(--step--1);
  }
  .cookie-consent-note { margin-bottom: 0; }
  .cookie-consent-note a { color: var(--link-on-dark); }
  .cookie-consent-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-top: var(--space-md);
  }
  .cookie-consent-actions .btn {
    padding: 0.65em 1.25em;
    font-size: var(--step--1);
    border-radius: 999px;
  }
  .cookie-consent-actions svg {
    width: 1em;
    height: 1em;
  }
  .cookie-consent-manage[hidden] { display: none; }
  .cookie-consent-option {
    padding-block: var(--space-sm);
    border-top: 1px solid var(--colour-ink-border);
  }
  .cookie-consent-option-title {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    font-weight: 600;
    color: var(--text-on-dark);
    margin-bottom: var(--space-3xs);
  }
  .cookie-consent-option-body {
    font-size: var(--step--1);
    margin-bottom: 0;
  }
</style>
