---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  href: string;
  title: string;
  summary: string;
  image: ImageMetadata;
  imageAlt?: string;
  readTime?: string;
}
const { href, title, summary, image, imageAlt = '', readTime } = Astro.props;
---
<a class="insight-card card" href={href}>
  <Picture src={image} alt={imageAlt} width={1200} height={800} widths={[400, 800, 1200]} sizes="(min-width: 64rem) 33vw, 100vw" formats={['avif', 'webp']} fallbackFormat="jpg" loading="lazy" class="insight-card-img" />
  <div class="insight-card-body">
    <p class="insight-card-eyebrow">Articles{readTime && ` — ${readTime}`}</p>
    <h3>{title}</h3>
    <p class="insight-card-summary">{summary}</p>
    <span class="insight-card-link">Read more →</span>
  </div>
</a>

<style>
  .insight-card {
    display: flex;
    flex-direction: column;
    padding: 0;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
  }
  .insight-card :global(img) {
    width: 100%;
    height: 11rem;
    object-fit: cover;
  }
  .insight-card-body {
    padding: var(--space-md);
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .insight-card-eyebrow {
    font-size: var(--step--1);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--colour-blue-400);
    margin-bottom: var(--space-2xs);
  }
  .insight-card-body h3 {
    font-size: var(--step-1);
    margin-bottom: var(--space-2xs);
  }
  .insight-card-summary {
    color: var(--text-on-dark-muted);
    font-size: var(--step--1);
  }
  .insight-card-link {
    font-weight: 600;
    color: var(--link-on-dark);
    font-size: var(--step--1);
    margin-top: auto;
    padding-top: var(--space-sm);
  }
</style>
