---
import { EMAIL } from '../consts';

// Submissions are delivered by Web3Forms (https://web3forms.com). Paste the
// access key Web3Forms emails you into WEB3FORMS_ACCESS_KEY below. The key
// is designed to sit in public HTML, so committing it is fine. While it is
// still the placeholder, the form shows a "please email us" note instead of
// pretending to work.
const WEB3FORMS_ACCESS_KEY = 'YOUR_WEB3FORMS_ACCESS_KEY';
const formReady = !WEB3FORMS_ACCESS_KEY.startsWith('YOUR_');

// Spam protection: hCaptcha via Web3Forms' free built-in integration. This
// is Web3Forms' shared free-plan site key, so there's no hCaptcha account
// to set up. Web3Forms verifies the token server-side once "hCaptcha" is
// selected as the captcha in the form's settings at app.web3forms.com.
// (reCAPTCHA is a paid Web3Forms Pro feature, which is why it isn't used.)
const HCAPTCHA_SITE_KEY = '50b2fe65-b00b-4b9e-ad62-3ba471098be2';

interface Props {
  compact?: boolean;
  heading?: string;
}
const { compact = false, heading = 'Project enquiry form' } = Astro.props;
const idPrefix = compact ? 'home-' : '';
---
<div class="contact-form-wrapper card">
  {!compact && <h2>{heading}</h2>}
  <form action="https://api.web3forms.com/submit" method="POST">
    <input type="hidden" name="access_key" value={WEB3FORMS_ACCESS_KEY} />
    <input type="hidden" name="subject" value="New project enquiry from commercialfitout.co.uk" />
    <input type="checkbox" name="botcheck" class="visually-hidden" tabindex="-1" autocomplete="off" />

    <div class="form-row form-row--split">
      <div>
        <label for={`${idPrefix}first-name`}>First name <span class="required">*</span></label>
        <input id={`${idPrefix}first-name`} name="first_name" type="text" autocomplete="given-name" required />
      </div>
      <div>
        <label for={`${idPrefix}last-name`}>Last name <span class="required">*</span></label>
        <input id={`${idPrefix}last-name`} name="last_name" type="text" autocomplete="family-name" required />
      </div>
    </div>

    <div class="form-row">
      <label for={`${idPrefix}email`}>Email address <span class="required">*</span></label>
      <input id={`${idPrefix}email`} name="email" type="email" autocomplete="email" required />
    </div>

    <div class="form-row">
      <label for={`${idPrefix}company`}>Company</label>
      <input id={`${idPrefix}company`} name="company" type="text" autocomplete="organization" />
    </div>

    <div class="form-row">
      <label for={`${idPrefix}phone`}>Phone number</label>
      <input id={`${idPrefix}phone`} name="phone" type="tel" autocomplete="tel" />
    </div>

    <div class="form-row">
      <label for={`${idPrefix}message`}>Your message</label>
      <textarea id={`${idPrefix}message`} name="message" rows={compact ? 3 : 5}></textarea>
    </div>

    <div class="form-row form-row--checkbox">
      <input id={`${idPrefix}privacy-consent`} name="privacy_consent" type="checkbox" required />
      <label for={`${idPrefix}privacy-consent`}>I agree to the <a href="/privacy-policy/">privacy policy</a> <span class="required">*</span></label>
    </div>

    <div class="form-row form-row--checkbox">
      <input id={`${idPrefix}newsletter`} name="newsletter" type="checkbox" />
      <label for={`${idPrefix}newsletter`}>Subscribe to occasional email updates from A2 Commercial Fit Out</label>
    </div>

    <div class="form-row">
      <div class="h-captcha" data-sitekey={HCAPTCHA_SITE_KEY}></div>
      <p class="captcha-note">This form is protected by hCaptcha. Its <a href="https://www.hcaptcha.com/privacy" target="_blank" rel="noopener noreferrer">Privacy Policy</a> and <a href="https://www.hcaptcha.com/terms" target="_blank" rel="noopener noreferrer">Terms of Service</a> apply.</p>
    </div>

    <button class="btn btn--primary" type="submit">Send enquiry</button>
    {!formReady && (
      <p class="form-note">Our online form isn't accepting enquiries just yet. Please email us at <a href={`mailto:${EMAIL}`}>{EMAIL}</a> in the meantime.</p>
    )}
  </form>
</div>

<script src="https://js.hcaptcha.com/1/api.js?recaptchacompat=off" async defer></script>

<style>
  .contact-form-wrapper h2 { margin-top: 0; }
  .form-row {
    margin-bottom: var(--space-sm);
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
  }
  .form-row--split {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
    gap: var(--space-sm);
  }
  .form-row--split > div {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
  }
  .form-row label {
    font-weight: 600;
    font-size: var(--step--1);
  }
  .required { color: var(--colour-focus); }
  .form-row input[type='text'],
  .form-row input[type='email'],
  .form-row input[type='tel'],
  .form-row textarea {
    font: inherit;
    padding: var(--space-xs);
    border: 1px solid var(--colour-steel-200);
    border-radius: var(--radius-sm);
  }
  .form-row--checkbox {
    flex-direction: row;
    align-items: start;
    gap: var(--space-2xs);
  }
  .form-row--checkbox input {
    margin-top: 0.3em;
  }
  .form-row--checkbox label {
    font-weight: 400;
  }
  .captcha-note {
    font-size: var(--step--1);
    color: var(--text-on-light-muted);
    margin-top: var(--space-2xs);
  }
  .form-note {
    font-size: var(--step--1);
    color: var(--text-on-light-muted);
    margin-top: var(--space-sm);
  }
</style>
