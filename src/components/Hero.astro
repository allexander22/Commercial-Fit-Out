---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  imageAlt?: string;
  eyebrow?: string;
}
const { image, imageAlt = '', eyebrow } = Astro.props;
---
<section class="hero bg-ink">
  <Picture src={image} alt={imageAlt} widths={[800, 1200, 1600]} sizes="100vw" width={1600} height={900} formats={['avif', 'webp']} fallbackFormat="jpg" loading="eager" fetchpriority="high" pictureAttributes={{ class: 'hero-picture' }} class="hero-img" />
  <div class="hero-overlay" aria-hidden="true"></div>
  <div class="container hero-content">
    {eyebrow && <p class="hero-eyebrow">{eyebrow}</p>}
    <h1><slot name="heading" /></h1>
    <div class="hero-body"><slot /></div>
    <div class="hero-actions"><slot name="actions" /></div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: var(--space-2xl);
    min-height: 28rem;
    display: flex;
    align-items: center;
  }
  .hero :global(.hero-picture) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }
  .hero :global(.hero-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(115deg, rgba(11,13,16,0.94) 20%, rgba(11,13,16,0.75) 100%);
    z-index: 1;
  }
  .hero-content {
    position: relative;
    z-index: 2;
    max-width: 44rem;
  }
  .hero-eyebrow {
    color: var(--link-on-dark);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: var(--step--1);
    margin-bottom: var(--space-xs);
  }
  .hero-body {
    font-size: var(--step-1);
    color: var(--text-on-dark-muted);
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-top: var(--space-md);
  }
</style>
