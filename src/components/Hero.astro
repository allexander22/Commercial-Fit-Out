---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  imageAlt?: string;
  eyebrow?: string;
}
const { image, imageAlt = '', eyebrow } = Astro.props;
---
<section class="hero bg-ink">
  <div class="container hero-grid">
    <div class="hero-content">
      {eyebrow && <p class="hero-eyebrow">{eyebrow}</p>}
      <h1><slot name="heading" /></h1>
      <div class="hero-body"><slot /></div>
      <div class="hero-actions"><slot name="actions" /></div>
    </div>

    <div class="hero-visual" aria-hidden={imageAlt === '' ? 'true' : undefined}>
      <div class="hero-visual-glow"></div>
      <Picture src={image} alt={imageAlt} widths={[400, 700, 900]} sizes="(min-width: 56rem) 32rem, 90vw" width={900} height={900} formats={['avif', 'webp']} fallbackFormat="jpg" loading="eager" fetchpriority="high" class="hero-img" />
      <div class="hero-visual-frame"></div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: var(--space-2xl);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
    align-items: center;
  }
  @media (min-width: 56rem) {
    .hero-grid {
      grid-template-columns: 1.1fr 1fr;
    }
  }
  .hero-content {
    max-width: 34rem;
  }
  .hero-eyebrow {
    color: var(--link-on-dark);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: var(--step--1);
    margin-bottom: var(--space-xs);
  }
  .hero-body {
    font-size: var(--step-1);
    color: var(--text-on-dark-muted);
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-top: var(--space-md);
  }

  .hero-visual {
    position: relative;
    aspect-ratio: 1 / 1;
    max-width: 28rem;
    margin-inline: auto;
    width: 100%;
  }
  .hero-visual :global(picture) {
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    height: 100%;
    border-radius: var(--radius-lg, 1rem);
    overflow: hidden;
  }
  .hero-visual :global(.hero-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .hero-visual-frame {
    position: absolute;
    inset: 0;
    z-index: 2;
    border-radius: var(--radius-lg, 1rem);
    border: 1px solid rgba(255, 255, 255, 0.14);
    pointer-events: none;
  }
  .hero-visual-glow {
    position: absolute;
    inset: -12%;
    z-index: 0;
    border-radius: 50%;
    background: radial-gradient(circle, var(--colour-blue-500, #2f7dd1) 0%, transparent 70%);
    opacity: 0.35;
    filter: blur(2.5rem);
    animation: hero-glow-pulse 7s ease-in-out infinite;
  }

  @keyframes hero-glow-pulse {
    0%, 100% { transform: scale(1); opacity: 0.3; }
    50% { transform: scale(1.08); opacity: 0.45; }
  }
</style>
