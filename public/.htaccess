# commercialfitout.co.uk — Krystal (LiteSpeed) server rules.
# Deployed from public/.htaccess on every push to main: edit it here, not on the server.
#
# URL rule: page URLs never end in a slash (the homepage "/" is the only exception).
# Astro builds pages as flat files (about.html, insights/cat-a-vs-cat-b-fit-out.html)
# and the rules below serve them at /about, /insights/cat-a-vs-cat-b-fit-out, etc.

Options -MultiViews -Indexes
DirectorySlash Off
DirectoryIndex index.html
ErrorDocument 404 /404.html

RewriteEngine On

# 1. Force HTTPS and the bare domain (www → apex) in a single 301.
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://commercialfitout.co.uk%{REQUEST_URI} [R=301,L,NE]

# 2. Strip trailing slashes: /about/ → /about (301).
RewriteRule ^(.+)/+$ /$1 [R=301,L,NE]

# 3. Strip .html / index.html from requested URLs: /about.html → /about (301).
#    THE_REQUEST is the original request line, so internal rewrites don't loop.
RewriteCond %{THE_REQUEST} \s/+(.*?)/?index\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L,NE]
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L,NE]

# 4. Serve /about from about.html (internal rewrite, no redirect).
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]
